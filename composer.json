{
	"name": "indianauniversity/omeka-s-module-oidc",
	"description": "OIDC authentication module for Omeka-S",
	"license": "Apache-2.0",
	"config": {
		"platform": {
			"php": "8.2.0"
		}
	},
	"require": {
		"guzzlehttp/guzzle": "^7.15.2",
		"facile-it/php-openid-client": "^1.0",
		"laminas/laminas-diactoros": "^2.18.1",
		"php": "^8.2"
	},
	"autoload": {
		"psr-4": {
			"OIDC\\": "src/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload-dev": {
		"psr-4": {
			"OIDC\\Test\\": "tests/"
		}
	},
	"scripts": {
		"lint": "@php tests/lint.php",
		"test": "phpunit --configuration phpunit.xml"
	}
}
